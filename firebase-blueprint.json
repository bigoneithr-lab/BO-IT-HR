{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Represents an employee in the CRM.",
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "First name of the employee"
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the employee"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the employee"
        },
        "role": {
          "type": "string",
          "description": "Job title or role"
        },
        "department": {
          "type": "string",
          "description": "Department the employee belongs to"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "On Leave", "Terminated"],
          "description": "Current employment status"
        },
        "joinDate": {
          "type": "string",
          "format": "date",
          "description": "Date the employee joined"
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the employee's avatar image"
        },
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who created this record"
        },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "bio": { "type": "string" },
        "reference": { "type": "string" }
      },
      "required": ["firstName", "lastName", "email", "role", "department", "status", "joinDate", "ownerId"]
    },
    "Applicant": {
      "title": "Applicant",
      "description": "Represents a job candidate.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "stage": { "type": "string", "enum": ["Applied", "Interviewing", "Offered", "Hired", "Rejected", "Converted"] },
        "appliedDate": { "type": "string", "format": "date" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "reference": { "type": "string" }
      },
      "required": ["firstName", "lastName", "email", "role", "stage", "appliedDate"]
    },
    "Payslip": {
      "title": "Payslip",
      "description": "Represents an employee's salary record.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "month": { "type": "string", "example": "2024-03" },
        "baseSalary": { "type": "integer" },
        "netSalary": { "type": "integer" },
        "status": { "type": "string", "enum": ["Draft", "Paid"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generatedBy": { "type": "string" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "paidBy": { "type": "string" }
      },
      "required": ["employeeId", "month", "baseSalary", "netSalary", "status", "generatedAt", "generatedBy"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Daily attendance for an employee.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "month": { "type": "string" },
        "status": { "type": "string", "enum": ["Present", "Absent", "Half Day", "On Leave", "Late", "Off Day"] },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "isLate": { "type": "boolean" },
        "markedBy": { "type": "string" }
      },
      "required": ["employeeId", "date", "month", "status", "markedBy"]
    },
    "Device": {
      "title": "Device",
      "description": "Represents a company device.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "serialNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Assigned", "Repaired", "Retired"] },
        "assignedTo": { "type": "string", "description": "ID of employee the device is assigned to" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "updatedBy", "updatedAt"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Represents an employee loan.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "totalAmount": { "type": "integer" },
        "monthlyInstallment": { "type": "integer" },
        "totalRepaid": { "type": "integer" },
        "remainingBalance": { "type": "integer" },
        "status": { "type": "string", "enum": ["Active", "Completed"] },
        "startDate": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["employeeId", "totalAmount", "monthlyInstallment", "totalRepaid", "remainingBalance", "status", "startDate", "updatedAt"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": {
        "$ref": "#/entities/Employee"
      },
      "description": "Stores employee records."
    },
    "/devices/{deviceId}": {
      "schema": {
        "$ref": "#/entities/Device"
      },
      "description": "Stores company device records."
    },
    "/payslips/{payslipId}": {
      "schema": {
        "$ref": "#/entities/Payslip"
      },
      "description": "Stores employee payroll records."
    },
    "/attendance/{recordId}": {
      "schema": {
        "$ref": "#/entities/AttendanceRecord"
      },
      "description": "Stores daily attendance records."
    },
    "/applicants/{applicantId}": {
      "schema": {
        "$ref": "#/entities/Applicant"
      },
      "description": "Stores job applicants."
    },
    "/loans/{loanId}": {
      "schema": {
        "$ref": "#/entities/Loan"
      },
      "description": "Stores employee loan records."
    }
  }
}
